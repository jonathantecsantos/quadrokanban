# Porta onde a API vai rodar
PORT=3000

# URL do Frontend permitida pelo CORS
FRONTEND_URL=http://localhost:5173

# URL do Banco de Dados
# Para desenvolvimento local com SQLite: file:./dev.db
# Para produção com PostgreSQL no Render: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="file:./dev.db"
